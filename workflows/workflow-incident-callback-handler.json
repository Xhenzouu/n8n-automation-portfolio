      ],
      "id": "74cbcb43-b402-43d4-b06a-ecffe2ba5313",
      "name": "Telegram Callback Webhook",
      "webhookId": "5cea41ab-f5ab-43a2-81eb-c5d50cad571a"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const body = item.json.body || {};\n  const cbq = body.callback_query;\n  \n  // Case 1: not a callback query (e.g. text message). No-op.\n  if (!cbq) {\n    results.push({\n      json: {\n        action: \"noop\",\n        incident_id: null,\n        callback_query_id: null\n      }\n    });\n    continue;\n  }\n  \n  const data = cbq.data || \"\";\n  const callbackQueryId = cbq.id || null;\n  \n  // Parse \"ack:<id>\" format\n  if (data.startsWith(\"ack:\")) {\n    const rawId = data.slice(4);\n    const incidentId = parseInt(rawId, 10);\n    \n    results.push({\n      json: {\n        action: \"ack\",\n        incident_id: isNaN(incidentId) ? null : incidentId,\n        callback_query_id: callbackQueryId\n      }\n    });\n    continue;\n  }\n  \n  // Unknown callback prefix\n  results.push({\n    json: {\n      action: \"unknown\",\n      incident_id: null,\n      callback_query_id: callbackQueryId\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "c82a5a2d-db1c-40e7-b70b-f1ea6d0f5ed1",
      "name": "Parse Ack Callback"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE workflow_incidents\nSET acknowledged_at = NOW()\nWHERE id = {{ $json.incident_id }}\n  AND acknowledged_at IS NULL\n  AND {{ $json.action === 'ack' }};",
        "options": {
          "queryBatching": "independently"
        }
      },
