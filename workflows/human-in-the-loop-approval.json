    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\n\n// If the Postgres node returned {success: true}, query Supabase for the latest row\n// Otherwise use the returned id\nlet draftId = result.id;\n\nif (!draftId) {\n  // Fallback: assume the most recent row is ours\n  // This is racy in multi-user but fine for a demo\n  return {\n    json: {\n      id: null,\n      needs_lookup: true\n    }\n  };\n}\n\nreturn {\n  json: {\n    id: draftId\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
