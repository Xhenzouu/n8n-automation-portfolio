    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Look up shipping status by order number. Use this when the customer asks about shipping, delivery, tracking, or when their order will arrive.",
        "operation": "executeQuery",
        "query": "SELECT\n  s.tracking_number,\n  s.carrier,\n  s.current_location,\n  s.estimated_delivery,\n  s.status\nFROM shipping s\nJOIN orders o ON o.order_number = s.order_number\nWHERE o.order_number = '{{ $fromAI(\"order_number\") }}'\nLIMIT 1;",
        "options": {}
