    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO draft_approvals (draft_original, draft_refined, source_chat_id)\nVALUES (\n  '{{ $('Webhook').first().json.body.draft.replace(/'/g, \"''\") }}',\n  '{{ $('Refine Draft').first().json.output.replace(/'/g, \"''\") }}',\n  '{{ $('Webhook').first().json.body.source_chat_id || \"\" }}'\n)\nRETURNING id;",
        "options": {}
